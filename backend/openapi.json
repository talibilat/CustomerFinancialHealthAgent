            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "financial-statement"
        ],
        "summary": "Update Financial Statement",
        "operationId": "update_financial_statement_financial_statement_put",
