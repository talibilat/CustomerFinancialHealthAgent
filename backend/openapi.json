    "/financial-statement": {
      "get": {
        "tags": [
          "financial-statement"
        ],
        "summary": "Retrieve Financial Statement",
        "operationId": "retrieve_financial_statement_financial_statement_get",
        "parameters": [
          {
            "name": "statement_period",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Statement Period"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
