# Application
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_DB=financial_health
POSTGRES_USER=financial_health
POSTGRES_PASSWORD=financial_health_local_only
DATABASE_URL=postgresql+psycopg://financial_health:financial_health_local_only@db:5432/financial_health

# Azure OpenAI resource endpoint, without /openai/v1/.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com

# Azure deployment names, not underlying model names.
# Set both values to the same deployment name when one deployment serves both tasks.
AZURE_OPENAI_CLASSIFICATION_DEPLOYMENT=your-classification-deployment
AZURE_OPENAI_GUIDANCE_DEPLOYMENT=your-guidance-deployment

# api_key for the portable demo; entra_id for DefaultAzureCredential.
AZURE_OPENAI_AUTH_MODE=api_key

# Leave blank in this committed example.
# This is required only when AZURE_OPENAI_AUTH_MODE=api_key.
AZURE_OPENAI_API_KEY=

AZURE_OPENAI_TIMEOUT_SECONDS=10
AZURE_OPENAI_MAX_RETRIES=1
AZURE_OPENAI_STORE=false

# Optional for a user-assigned managed identity when auth mode is entra_id.
AZURE_CLIENT_ID=

# Optional service-principal settings for entra_id mode outside managed identity.
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
